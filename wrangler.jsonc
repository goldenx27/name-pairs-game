{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "name-pairs-game",
  "main": "src/main.js",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "name-pairs-db",
      "database_id": "17ee6612-aec3-44db-8ae2-377c6667fc6e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "name-pairs-media"
    }
  ]
}
